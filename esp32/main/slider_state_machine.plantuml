@startuml slider_state_machine

/'
  State Machine for TV Slider
  
  The system controls a stepper motor to slide a TV in/out of a wall.
  
  Hall Sensors: 
  - IN_STOP:  TV fully retracted (in position)
  - IN_SLOW:  Approaching in position (start ramping down)
  - OUT_SLOW:  Approaching out position (start ramping down)
  - OUT_STOP: TV fully extended (out position)
  
  Event-driven architecture:  uses timer events for ramping
'/

' ///////////////////////////// STYLES /////////////////////////////
skinparam state {
    BackgroundColor<<red>> a20025
    FontColor<<red>> white
    BackgroundColor<<green>> 25a050
    FontColor<<green>> white
    BackgroundColor<<yellow>> f0a020
    FontColor<<yellow>> black
    BackgroundColor<<blue>> 039eff
    FontColor<<blue>> white
}

' //////////////////////// STATE ORGANIZATION ///////////////////////

state STOPPED_STATE <<green>>
state ERROR_STATE <<red>>

state MOVING_OUT_STATE <<blue>> {
    state OUT_RAMP_UP_STATE <<yellow>>
    state OUT_FULL_SPEED_STATE <<yellow>>
    state OUT_RAMP_DOWN_STATE <<yellow>>
}

state MOVING_IN_STATE <<blue>> {
    state IN_RAMP_UP_STATE <<yellow>>
    state IN_FULL_SPEED_STATE <<yellow>>
    state IN_RAMP_DOWN_STATE <<yellow>>
}

' ///////////////////////// STATE HANDLERS /////////////////////////

[*] --> STOPPED_STATE

STOPPED_STATE: enter / { \n    slider_motor_enable(false); \n    slider_speed_set(0); \n}
STOPPED_STATE --> OUT_RAMP_UP_STATE: CMD_MOVE_OUT [!slider_is_at_out_stop()]
STOPPED_STATE --> IN_RAMP_UP_STATE: CMD_MOVE_IN [!slider_is_at_in_stop()]
STOPPED_STATE -down-> ERROR_STATE: MOTOR_FAULT

' ===== COMMON TRANSITIONS FOR ALL MOVING STATES =====
MOVING_OUT_STATE --> STOPPED_STATE: CMD_STOP
MOVING_OUT_STATE --> STOPPED_STATE: SENSOR_OUT_STOP
MOVING_OUT_STATE --> ERROR_STATE: MOTOR_FAULT

MOVING_IN_STATE --> STOPPED_STATE: CMD_STOP
MOVING_IN_STATE --> STOPPED_STATE: SENSOR_IN_STOP
MOVING_IN_STATE --> ERROR_STATE: MOTOR_FAULT

' ===== MOVING OUT =====
OUT_RAMP_UP_STATE: enter / { \n    slider_motor_enable(true); \n    slider_direction_set(SLIDER_DIRECTION_OUT); \n    speed = SLIDER_MIN_SPEED; \n    slider_speed_set(speed); \n    slider_start_timer(SLIDER_RAMP_INTERVAL_MS); \n}
OUT_RAMP_UP_STATE: TIMER_EXPIRED [speed < SLIDER_MAX_SPEED] / { \n    speed += SLIDER_SPEED_STEP; \n    slider_speed_set(speed); \n    slider_start_timer(SLIDER_RAMP_INTERVAL_MS); \n}
OUT_RAMP_UP_STATE --> OUT_FULL_SPEED_STATE: TIMER_EXPIRED [speed >= SLIDER_MAX_SPEED]
OUT_RAMP_UP_STATE --> OUT_RAMP_DOWN_STATE: SENSOR_OUT_SLOW

OUT_FULL_SPEED_STATE: enter / { \n    slider_speed_set(SLIDER_MAX_SPEED); \n}
OUT_FULL_SPEED_STATE --> OUT_RAMP_DOWN_STATE:  SENSOR_OUT_SLOW

OUT_RAMP_DOWN_STATE:  enter / { \n    slider_start_timer(SLIDER_RAMP_INTERVAL_MS); \n}
OUT_RAMP_DOWN_STATE: TIMER_EXPIRED [speed > SLIDER_MIN_SPEED] / { \n    speed -= SLIDER_SPEED_STEP; \n    slider_speed_set(speed); \n    slider_start_timer(SLIDER_RAMP_INTERVAL_MS); \n}

' ===== MOVING IN =====
IN_RAMP_UP_STATE: enter / { \n    slider_motor_enable(true); \n    slider_direction_set(SLIDER_DIRECTION_IN); \n    speed = SLIDER_MIN_SPEED; \n    slider_speed_set(speed); \n    slider_start_timer(SLIDER_RAMP_INTERVAL_MS); \n}
IN_RAMP_UP_STATE: TIMER_EXPIRED [speed < SLIDER_MAX_SPEED] / { \n    speed += SLIDER_SPEED_STEP; \n    slider_speed_set(speed); \n    slider_start_timer(SLIDER_RAMP_INTERVAL_MS); \n}
IN_RAMP_UP_STATE --> IN_FULL_SPEED_STATE: TIMER_EXPIRED [speed >= SLIDER_MAX_SPEED]
IN_RAMP_UP_STATE --> IN_RAMP_DOWN_STATE: SENSOR_IN_SLOW

IN_FULL_SPEED_STATE: enter / { \n    slider_speed_set(SLIDER_MAX_SPEED); \n}
IN_FULL_SPEED_STATE --> IN_RAMP_DOWN_STATE: SENSOR_IN_SLOW

IN_RAMP_DOWN_STATE: enter / { \n    slider_start_timer(SLIDER_RAMP_INTERVAL_MS); \n}
IN_RAMP_DOWN_STATE: TIMER_EXPIRED [speed > SLIDER_MIN_SPEED] / { \n    speed -= SLIDER_SPEED_STEP; \n    slider_speed_set(speed); \n    slider_start_timer(SLIDER_RAMP_INTERVAL_MS); \n}

' ===== ERROR_STATE STATE =====
ERROR_STATE: enter / { \n    slider_fault_handler(); \n}
ERROR_STATE --> STOPPED_STATE: CMD_CLEAR_FAULT

' //////////////////////// StateSmith config ////////////////////////
/'!  $CONFIG : toml
[RenderConfig]
FileTop = """
    // Motor Controller State Machine for TV Slider
    // Generated by StateSmith
    // Event-driven architecture
    """
AutoExpandedVars = """
    uint16_t speed;               // current motor speed
    """

[RenderConfig.C]
HFileIncludes = """
    #include <stdint.h>
    #include <stdbool.h>
    #include "slider_types.h"
    """
CFileIncludes = """
    #include "esp_log.h"
    #include "slider.h"
    """

[SmRunnerSettings]
transpilerId = "C99"
'/

@enduml